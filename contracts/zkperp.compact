// SPDX-License-Identifier: Apache-2.0

pragma language_version >= 0.16;

import CompactStandardLibrary;

// zkperp — private perpetuals against a GMX-style liquidity pool.
//
// ── The model ──────────────────────────────────────────────────────────────
//
// As in GMX v1, there is no order book and no counterparty trader. Liquidity
// providers deposit pUSDC into one pool and receive zLP shares; the pool is the
// counterparty to every position, long or short. When a position closes in
// profit the pool pays the profit; when it closes at a loss the pool keeps
// the collateral lost.
// Prices come from an oracle (here: a mock, set by the admin).
//
// Pool and positions live in ONE contract because they have to: a Midnight
// contract can neither call another nor read another's ledger, so a pool in a
// separate contract could not see a position it is meant to settle.
//
// ── What is private, and what is not ───────────────────────────────────────
//
// PUBLIC, deliberately — the same things GMX publishes:
//   · pool liquidity (`poolValue`) and LP share supply (`lpSupply`), and so
//     each LP deposit's size, as the difference between two reads.
//   · the mark price, and therefore the entry price of anything opened at it.
//   · that a position was opened (`openPositions`), and when.
//
// PRIVATE — never on chain in any form a reader can recover:
//   · the position's size, collateral and leverage;
//   · its direction, at open. Longs and shorts open through one circuit and
//     differ only inside the commitment. At close the direction follows from
//     whether the pool paid or gained and which way the price moved, unless
//     the price did not move.
//   · who owns it. The owner is a hash of a secret only the trader holds, not
//     a wallet key, so positions are not linkable to each other or to the
//     trader's other activity through the ledger.
//
// A position exists on chain only as a commitment: a hash over its fields plus
// a random salt, appended to `positions`. The salt is what stops a reader from
// guessing sizes and hashing until one matches.
//
// The collateral is a pUSDC coin sent to this contract and deliberately NOT
// written to the ledger. Storing a coin publishes its value, and the value is
// the collateral. The coin sits in the Zswap tree as an ordinary shielded
// output owned by this contract; only the trader knows its nonce and value,
// and the position commitment binds them, so only the trader can later name
// it to be spent.
//
// ── Solvency without per-position numbers ──────────────────────────────────
//
// GMX reserves `size` worth of pool assets per position so profits are always
// payable. Here that would publish every size. Instead, every position's
// profit is capped at one public constant, `maxPayout` — an enforced
// take-profit — and every open reserves exactly that much, whatever the real
// size. The reservation says nothing about the position; the total is just
// (live positions × maxPayout), and the position count is public anyway.
//
// Invariant: poolValue > live positions × maxPayout. An open or an LP
// withdrawal that would break it is refused (an idle pool may be emptied
// entirely). A close pays at most maxPayout and frees one reservation, and a
// loss only adds to the pool, so every open position's profit is payable.
//
// ── Concurrency: what a trade may read ─────────────────────────────────────
//
// A transaction is proven against the state it read, and fails if any value
// it read EXACTLY has changed by the time it lands. Increments, decrements and
// `lessThan` checks on a Counter, Merkle and set inserts, and writes that do
// not read, all commute (measured with `npm run probe:race`). So trades are
// kept off every value other trades write:
//
//   · the reservation is a Counter of free slots, one slot = maxPayout. An
//     open checks `!freeSlots.lessThan(1)` and decrements; a close
//     increments. Neither reads an exact value, so opens and closes do not
//     invalidate each other.
//   · how many slots the pool holds, `slotCapacity`, changes only when the
//     pool's value does — LP deposits and withdrawals, fee deposits, closes
//     with a profit or loss. Those already conflict over the pool coin.
//   · a close at an unchanged price reads neither the pool coin nor
//     `poolValue`.
//
// The mark price and its time are read by every trade on purpose: pricing is
// strict, so a trade proven at one price fails if the price changes before it
// lands, and a trade refuses a price older than `maxPriceAge`.
//
// Why a constant cap and not k × collateral: a position that hits a cap is
// paid exactly the cap, publicly, so a collateral-relative cap publishes the
// collateral whenever it binds. A constant one publishes only that it bound.
// The price is capital efficiency: the pool must hold maxPayout per position.
//
// ⚠️ Closing publishes the PnL. Profit leaves the public pool and a loss
// enters it, so the pool's change IS the position's PnL. Opens and closes are
// unlinkable (a close names a nullifier, not a leaf), and the entry price is
// not published at close — but PnL = size × (exit − entry) / entry, so an
// observer who guesses the entry from the price history narrows the size to a
// few candidates. A close at an unchanged price moves nothing and reveals
// nothing beyond "a position closed".
//
// ── Fees, and why they never touch the pool per trade ──────────────────────
//
// Three fees, each proportional to size and rounded UP, so rounding never
// favours the trader and many tiny positions cannot shave them off:
//   opening  size × openFeeBps / 10 000, taken out of the collateral at open;
//   closing  size × closeFeeBps / 10 000, taken out of the payout;
//   borrow   size × borrowRate × seconds held / 10^12, at close.
// As with PnL, the trader supplies each fee and the circuit pins it exactly.
//
// A fee is a fixed fraction of size, so a fee paid into the public pool would
// publish the size. Fees therefore go to `treasury`, a wallet key, as shielded
// outputs: the public sees neither the amount nor the recipient. The treasury
// pays the LPs' share back into the pool per epoch with `depositFees`, so only
// epoch totals become public. The pool's change at a close stays the PnL alone.
//
// ⚠️ This trusts the treasury: whoever holds its key sees every fee, and so
// every position's size, and holds the LPs' share until it deposits it. The
// contract cannot enforce the deposit or the LP/protocol split.
//
// The opening fee stays inside the collateral coin until close — moving it at
// open would publish it — and leaves with the other two.
//
// ── Liquidation ────────────────────────────────────────────────────────────
//
// A position whose equity (collateral less loss, closing and borrow fees)
// falls below `maintenanceBps` of its size can be closed without its owner
// secret, by `liquidatePosition`. The rest of its equity, less a liquidation
// fee, still goes to the trader's `payTo`; the fee goes to the treasury, which
// runs the keeper.
//
// To liquidate, the keeper needs every field of the position except the owner
// secret, and none of them is public. So every open writes a second note,
// encrypted IN THE CIRCUIT to the `liquidator` key (see `sealLiquidatorNote`):
// the trader cannot hand the keeper a false copy, because the circuit builds
// the note from the very fields it commits to. The nullifier depends on the
// salt only, so the keeper can retire the position without the owner secret.
//
// ⚠️ This trusts the liquidator key's holder, like the treasury: it sees every
// position's size, direction, entry and collateral, and can tell when each one
// closes. It cannot close a healthy position nor take any payout.
//
// ── Trigger orders: stop loss and take profit ──────────────────────────────
//
// The owner may attach an order to an open position: close it once the mark
// price reaches a level, from below or from above. A long's stop loss and a
// short's take profit fire at or below their level; a long's take profit and
// a short's stop loss at or above. The trader is offline when it fires, so the
// keeper executes it, with `executeOrder`, and the close settles exactly as
// `closePosition` does, at the mark price, paying the position's `payTo`.
//
// An order exists on chain only as a commitment in `orders`, with a note
// encrypted to the liquidator key (written by the trader, not the circuit: a
// false note only stops the trader's own order from firing). Placing one needs
// the owner secret, or the keeper, who knows every other field, could attach
// an order at the current price and close any position. Cancelling publishes
// the order's nullifier, from its salt, so it links to nothing.
//
// ⚠️ The keeper sees each order's level. The public sees that some position
// got an order, and later that an order closed some position; executing
// through its own circuit tells that the close was not the trader's own.
//
// ── Limit orders ───────────────────────────────────────────────────────────
//
// A limit order is an open that waits for its price: a long that opens once
// the mark price is at or below the limit, a short at or above. The trader is
// offline when it fills, so placing it posts the collateral coin now, as an
// open would, and commits to every field the position will have except its
// entry price and open time. The keeper fills it with `executeLimitOrder`,
// which opens the position at the mark price — never worse than the limit —
// with the coin already held as its collateral, and writes its liquidator note
// as `openPosition` does. Until then the owner may cancel, which returns the
// coin to `payTo`.
//
// An order may carry an expiry: past it, it no longer fills, and the owner
// cancels it to get the coin back. The check compares the expiry with the
// fill's open time, which is public and pinned to the block's time, so the
// expiry itself stays private.
//
// Leverage, fees and the collateral floor are checked when the order is
// placed; the pool's room (a free slot) when it fills, so a full pool makes
// the order wait.
//
// ⚠️ The public sees that a limit order was placed (not its side, size or
// level) and later that one filled or was cancelled, through each one's own
// circuit; a fill at the mark of the moment says the level was near there.
// The keeper sees every order's level, as for trigger orders, and names the
// fill's open time within `clockSlack`, as a trader names their own.
//
// Not yet here: funding.

// ── Configuration, frozen at deploy ────────────────────────────────────────

// The only token accepted as liquidity or collateral: pUSDC's `tokenId`.
export sealed ledger usdc: Bytes<32>;

// Hash of the admin's secret; see `adminKey`. Controls the mock oracle only.
export sealed ledger admin: Bytes<32>;

// Largest size / collateral a position may open at, on the collateral net
// of the opening fee.
export sealed ledger maxLeverage: Uint<8>;

// Smallest collateral a position may post, in pUSDC minor units.
export sealed ledger minCollateral: Uint<64>;

// The most any position can win, in pUSDC minor units, and so the liquidity
// each open position reserves. See "Solvency" above.
export sealed ledger maxPayout: Uint<64>;

// Fees; see "Fees" above. Basis points of size, and a per-second rate in
// units of 10^-12 of size. The opening fee is at least one basis point, so
// every close sends the treasury something and no send is of nothing.
export sealed ledger openFeeBps: Uint<16>;
export sealed ledger closeFeeBps: Uint<16>;
export sealed ledger borrowRate: Uint<32>;

// Receives every fee, shielded.
export sealed ledger treasury: ZswapCoinPublicKey;

// How far an open or close time may trail the block time, in seconds. The
// trader names the time (a circuit cannot read the clock, only compare
// against it) and gains from naming it early at close, so this bounds the
// borrow fee they can dodge to `clockSlack` seconds' worth.
export sealed ledger clockSlack: Uint<32>;

// The oldest price a trade accepts, in seconds since the oracle's own
// timestamp. Chainlink's ETH/USD feed updates on a 0.5% move or hourly, so a
// price up to an hour old is still current; this should sit just above that
// heartbeat. If the oracle stops, trading — closes included — waits for it.
export sealed ledger maxPriceAge: Uint<32>;

// Liquidation; see "Liquidation" above. A position is liquidatable once its
// equity is below `maintenanceBps` of its size; the liquidation fee is
// `liquidationFeeBps` of size, taken out of what equity is left.
export sealed ledger maintenanceBps: Uint<16>;
export sealed ledger liquidationFeeBps: Uint<16>;

// The keeper's public key. Every open encrypts its position to it.
export sealed ledger liquidator: JubjubPoint;

// ── Oracle ─────────────────────────────────────────────────────────────────

// Price of the traded asset in USD, 6 decimals: 3000_000000 is $3,000.
export ledger markPrice: Uint<64>;

// When the oracle observed `markPrice`, in seconds since the epoch — for
// Chainlink, the round's `updatedAt`. Every trade checks it against the block
// time; see `freshPrice`.
export ledger priceTime: Uint<64>;

// ── Pool ───────────────────────────────────────────────────────────────────

// All liquidity, merged into one coin owned by this contract. Stored on the
// ledger — which publishes its value — because anyone must be able to spend it
// to settle: an LP adding liquidity, a trader closing in profit. That is the
// public pool GMX has too.
export ledger pool: QualifiedShieldedCoinInfo;

// `pool.value`, narrowed to 64 bits for arithmetic. Zero means no pool coin
// exists yet.
export ledger poolValue: Uint<64>;

// zLP: shares in the pool, a shielded token minted by this contract.
export ledger lpToken: Bytes<32>;
export ledger lpSupply: Uint<64>;
export ledger lpMintCounter: Counter;

// Reservations, in slots of maxPayout each. `slotCapacity` is how many the
// pool can back, floor((poolValue − 1) / maxPayout), or 0 when it is empty;
// `freeSlots` is that less the live positions. Reserved liquidity is
// (slotCapacity − freeSlots) × maxPayout. See "Concurrency" above.
export ledger slotCapacity: Uint<64>;
export ledger freeSlots: Counter;

// ── Positions ──────────────────────────────────────────────────────────────

// Everything a position commits to. Never stored; only its hash is.
export struct Position {
  // `ownerKey(secret)`: proves ownership at close without naming a wallet.
  // A field element, so the liquidator's note carries it without slicing.
  owner: Field;
  // Long profits when the price rises, short when it falls.
  isLong: Boolean;
  // Notional, in pUSDC minor units. Size / collateral is the leverage.
  size: Uint<64>;
  // Net of the opening fee. The collateral coin holds collateral + openFee.
  collateral: Uint<64>;
  openFee: Uint<64>;
  entryPrice: Uint<64>;
  // Seconds since the epoch, as checked against the block time at open.
  openTime: Uint<64>;
  // Identifies the collateral coin this contract holds for this position.
  // Below the field size, as the liquidator's note casts it to a field.
  collateralNonce: Bytes<32>;
  // Random, 32 bytes below the field size. Without it the commitment is
  // guessable.
  salt: Bytes<32>;
  // The wallet that opened the position, and the only one a close can pay.
  // Whoever learns the owner secret can still close the position, but the
  // money goes here. Inside the commitment, so it is never published.
  payTo: ZswapCoinPublicKey;
}

// Commitments to every position ever opened. A Merkle tree rather than a set
// so that closing can later prove membership WITHOUT naming which leaf — a set
// lookup would link the close to the open. Depth 20: about a million positions.
export ledger positions: HistoricMerkleTree<20, Bytes<32>>;

// How many positions have been opened. Public by nature: each open is a
// transaction anyone can see.
export ledger openPositions: Counter;

// Nullifiers of closed positions; see `positionNullifier`.
export ledger closed: Set<Bytes<32>>;
export ledger closedPositions: Counter;

// One encrypted note per position, written at open: the opening, sealed under
// a key only the trader can reproduce (see core/notes.ts). This lets the trader
// find and close the position from any device, without a local record. The
// contract never reads a note. Each one is fixed-size random-looking bytes,
// and a close names no note, so notes link nothing. A Set, not a list: inserts
// of different values commute, so concurrent opens do not conflict.
export ledger notes: Set<Bytes<128>>;

// One note per position for the keeper: the position's fields, minus nothing
// the keeper needs and plus nothing it must not have, encrypted to
// `liquidator` by the open circuit itself. See `sealLiquidatorNote`.
export struct LiquidatorNote {
  // e·G for the open's ephemeral scalar e. The keeper's shared secret is
  // e·L = l·(e·G), for its key L = l·G.
  ephemeral: JubjubPoint;
  // `liquidatorPlaintext(...)`, each element plus a mask from the shared
  // secret. Uniform field elements to anyone else.
  fields: Vector<10, Field>;
}
export ledger liquidatorNotes: Set<LiquidatorNote>;

// ── Trigger orders ─────────────────────────────────────────────────────────

// Everything an order commits to. Never stored; only its hash is.
export struct TriggerOrder {
  // `positionCommitment` of the position it closes.
  position: Bytes<32>;
  // The mark price at which it fires, 6 decimals.
  price: Uint<64>;
  // Fires when the mark price is at or above `price` if true, at or below if
  // false.
  above: Boolean;
  // Random, below the field size, as the keeper's note carries it.
  salt: Bytes<32>;
}

// Commitments to every order ever placed; a Merkle tree, so executing proves
// membership without naming the leaf.
export ledger orders: HistoricMerkleTree<20, Bytes<32>>;

// Nullifiers of cancelled orders; see `orderNullifier`.
export ledger cancelledOrders: Set<Bytes<32>>;

// One note per order for the keeper, in the liquidator note's format: see
// `orderPlaintext` in core/orders.ts.
export ledger orderNotes: Set<LiquidatorNote>;

// ── Limit orders ───────────────────────────────────────────────────────────

// Everything a limit order commits to: the position it will open, less the
// entry price and open time. Never stored; only its hash is.
export struct LimitOrder {
  owner: Field;
  isLong: Boolean;
  size: Uint<64>;
  // Net of the opening fee, as in `Position`.
  collateral: Uint<64>;
  openFee: Uint<64>;
  // A long fills at or below it, a short at or above. 6 decimals.
  price: Uint<64>;
  // Seconds since the epoch after which it no longer fills; 0 for never.
  expiry: Uint<64>;
  collateralNonce: Bytes<32>;
  // Becomes the position's salt. Below the field size.
  salt: Bytes<32>;
  payTo: ZswapCoinPublicKey;
  // The trader's encryption key, which the fill's liquidator note carries.
  payToEnc: Bytes<32>;
}

// Commitments to every limit order ever placed; a Merkle tree, so a fill or a
// cancel proves membership without naming the leaf.
export ledger limitOrders: HistoricMerkleTree<20, Bytes<32>>;

// Nullifiers of filled and cancelled limit orders; see `limitNullifier`.
export ledger limitDone: Set<Bytes<32>>;

// For each fill, by nullifier: the entry price and open time. Both are public
// anyway (the mark price and the transaction's time); the trader needs them
// to rebuild the position's commitment.
export struct LimitFill {
  entryPrice: Uint<64>;
  openTime: Uint<64>;
}
export ledger limitFills: Map<Bytes<32>, LimitFill>;

// One note per limit order for the keeper, in the liquidator note's format:
// see `limitPlaintext` in core/limits.ts.
export ledger limitNotes: Set<LiquidatorNote>;

constructor(
  usdcToken: Bytes<32>,
  adminCommitment: Bytes<32>,
  initialPrice: Uint<64>,
  initialPriceTime: Uint<64>,
  leverageCap: Uint<8>,
  collateralFloor: Uint<64>,
  payoutCap: Uint<64>,
  openFee: Uint<16>,
  closeFee: Uint<16>,
  rate: Uint<32>,
  feeRecipient: ZswapCoinPublicKey,
  slack: Uint<32>,
  priceAge: Uint<32>,
  maintenance: Uint<16>,
  liquidationFee: Uint<16>,
  liquidatorKey: JubjubPoint
) {
  usdc = disclose(usdcToken);
  admin = disclose(adminCommitment);
  assert(disclose(initialPrice) > 0, "price must be positive");
  markPrice = disclose(initialPrice);
  priceTime = disclose(initialPriceTime);
  assert(disclose(leverageCap) >= 1, "leverage cap must be at least 1x");
  maxLeverage = disclose(leverageCap);
  minCollateral = disclose(collateralFloor);
  assert(disclose(payoutCap) > 0, "the payout cap must be positive");
  maxPayout = disclose(payoutCap);
  assert(disclose(openFee) >= 1 && disclose(openFee) <= 10000, "the opening fee must be 1 to 10 000 bps");
  openFeeBps = disclose(openFee);
  assert(disclose(closeFee) <= 10000, "the closing fee is at most 10 000 bps");
  closeFeeBps = disclose(closeFee);
  borrowRate = disclose(rate);
  treasury = disclose(feeRecipient);
  assert(disclose(slack) > 0, "the clock slack must be positive");
  clockSlack = disclose(slack);
  assert(disclose(priceAge) > 0, "the price age limit must be positive");
  maxPriceAge = disclose(priceAge);
  assert(disclose(maintenance) >= 1 && disclose(maintenance) < 10000, "the maintenance margin must be 1 to 9 999 bps");
  maintenanceBps = disclose(maintenance);
  assert(disclose(liquidationFee) <= 10000, "the liquidation fee is at most 10 000 bps");
  liquidationFeeBps = disclose(liquidationFee);
  liquidator = disclose(liquidatorKey);
  lpToken = default<Bytes<32>>;
}

// Domain-separated, so an admin secret and a position owner secret can never
// be confused even if someone reuses one.
export pure circuit adminKey(secret: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<2, Bytes<32>>>([pad(32, "zkperp:admin"), secret]);
}

// A field element rather than the 32-byte hash: the liquidator's note then
// carries it as is. Reducing a 256-bit hash into the field keeps it far out of
// reach of a collision.
export pure circuit ownerKey(secret: Bytes<32>): Field {
  return degradeToTransient(persistentHash<Vector<2, Bytes<32>>>([pad(32, "zkperp:owner"), secret]));
}

export pure circuit positionCommitment(p: Position): Bytes<32> {
  return persistentHash<Position>(p);
}

// Published when a position closes, so it cannot close twice. Derived from the
// salt, which only the trader and the liquidator know, so the public cannot
// match it to the commitment it retires. That unlinkability is why a close
// proves membership in `positions` instead of naming a leaf. Not from the
// owner secret: a liquidation must be able to retire the position without it.
export pure circuit positionNullifier(salt: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<2, Bytes<32>>>([pad(32, "zkperp:nullifier:v2"), salt]);
}

export pure circuit orderCommitment(o: TriggerOrder): Bytes<32> {
  return persistentHash<TriggerOrder>(o);
}

// Published when an order is cancelled. From the salt, which only the trader
// and the keeper know, so it cannot be matched to the order's commitment.
export pure circuit orderNullifier(salt: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<2, Bytes<32>>>([pad(32, "zkperp:order:nullifier"), salt]);
}

export pure circuit limitCommitment(o: LimitOrder): Bytes<32> {
  return persistentHash<LimitOrder>(o);
}

// Published when a limit order fills or is cancelled. From the salt, in its
// own domain, so it links neither to the order's commitment nor to the
// position's nullifier, which the same salt derives.
export pure circuit limitNullifier(salt: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<2, Bytes<32>>>([pad(32, "zkperp:limit:nullifier"), salt]);
}

// ── The liquidator's note ──────────────────────────────────────────────────
//
// ECDH on Jubjub plus a Poseidon mask per field element: for the open's
// ephemeral scalar e and the keeper's key L, the shared secret is
// k = transientHash(e·L), and element i is plaintext[i] + transientHash(k, i).
// Each mask is uniform in the field, so a ciphertext element is uniform to
// anyone without k, whatever field element it hides.
//
// transientHash is not promised to stay the same across compiler versions:
// the keeper decrypts each note when it appears and keeps the plaintext.

// The keeper's public key for secret scalar `secret`.
export pure circuit liquidatorPublicKey(secret: Field): JubjubPoint {
  return ecMulGenerator(secret);
}

export pure circuit liquidatorShared(point: JubjubPoint, scalar: Field): Field {
  return transientHash<JubjubPoint>(ecMul(point, scalar));
}

export pure circuit liquidatorMask(shared: Field, i: Field): Field {
  return transientHash<Vector<2, Field>>([shared, i]);
}

// Everything the keeper needs, as ten field elements:
//
//   0 owner          a field element already
//   1 collateralNonce, 2 salt   cast whole: both are drawn below the field size
//   3, 4 payTo       its two 16-byte halves, little-endian
//   5 size | collateral, 6 openFee | entryPrice, 7 openTime | isLong   64 bits each
//   8, 9 payToEnc    the trader's encryption key, in halves
//
// No `slice`: in a proof it costs as much as everything else in the open
// together (measured: 4 MB of proving key per slice, against 0.07 MB to cast a
// 16-byte argument). So 32-byte values that must be split arrive as halves.
// `payToEnc` is not in the commitment; a wrong one only hides the trader's own
// coin from their wallet. `payTo` is, and `openPosition` ties its halves to it.
export pure circuit liquidatorPlaintext(
  p: Position,
  payToLo: Bytes<16>,
  payToHi: Bytes<16>,
  encLo: Bytes<16>,
  encHi: Bytes<16>
): Vector<10, Field> {
  const shift = 18446744073709551616;
  return [
    p.owner,
    p.collateralNonce as Field,
    p.salt as Field,
    payToLo as Field,
    payToHi as Field,
    (p.size as Field) + (p.collateral as Field) * shift,
    (p.openFee as Field) + (p.entryPrice as Field) * shift,
    (p.openTime as Field) + ((p.isLong ? 1 : 0) as Field) * shift,
    encLo as Field,
    encHi as Field
  ];
}

export pure circuit sealLiquidatorNote(m: Vector<10, Field>, key: JubjubPoint, ephemeral: Field): LiquidatorNote {
  const k = liquidatorShared(key, ephemeral);
  return LiquidatorNote {
    ephemeral: ecMulGenerator(ephemeral),
    fields: [
      m[0] + liquidatorMask(k, 0), m[1] + liquidatorMask(k, 1), m[2] + liquidatorMask(k, 2),
      m[3] + liquidatorMask(k, 3), m[4] + liquidatorMask(k, 4), m[5] + liquidatorMask(k, 5),
      m[6] + liquidatorMask(k, 6), m[7] + liquidatorMask(k, 7), m[8] + liquidatorMask(k, 8),
      m[9] + liquidatorMask(k, 9)
    ]
  };
}

// The keeper's side: the plaintext elements of `note`, for its secret scalar.
export pure circuit openLiquidatorNote(note: LiquidatorNote, secret: Field): Vector<10, Field> {
  const k = liquidatorShared(note.ephemeral, secret);
  const c = note.fields;
  return [
    c[0] - liquidatorMask(k, 0), c[1] - liquidatorMask(k, 1), c[2] - liquidatorMask(k, 2),
    c[3] - liquidatorMask(k, 3), c[4] - liquidatorMask(k, 4), c[5] - liquidatorMask(k, 5),
    c[6] - liquidatorMask(k, 6), c[7] - liquidatorMask(k, 7), c[8] - liquidatorMask(k, 8),
    c[9] - liquidatorMask(k, 9)
  ];
}

// ── Mock oracle ────────────────────────────────────────────────────────────

// Sets the mark price, observed by the oracle at `updatedAt` (seconds since
// the epoch). Authorised by a secret, not by `ownPublicKey()`: the caller
// supplies that key themselves, so checking it proves nothing.
//
// The time may not be in the future, nor older than the current price's, so a
// relayer cannot replay an older round to move the price back.
export circuit setPrice(price: Uint<64>, updatedAt: Uint<64>, secret: Bytes<32>): [] {
  assert(admin == disclose(adminKey(secret)), "not the admin");
  assert(disclose(price) > 0, "price must be positive");
  const t = disclose(updatedAt);
  assert(blockTimeGte(t), "the price time is in the future");
  assert(t >= priceTime, "the price time is older than the current price's");
  markPrice = disclose(price);
  priceTime = t;
}

// Every open and close prices against `markPrice` and calls this first. It
// reads `priceTime`, which changes only when the price does, so it adds no
// conflict a trade does not already have with a price update.
circuit freshPrice(): [] {
  assert(blockTimeLt((priceTime + maxPriceAge) as Uint<64>), "the price is stale");
}

// ── Liquidity ──────────────────────────────────────────────────────────────

// Records that the pool is now worth `nextValue`, and grows or shrinks the
// free slots by the change in capacity. `capacity` is computed by the caller,
// because circuits cannot divide, and pinned here. Shrinking below the live
// positions is refused: that liquidity backs their maximum profit.
circuit repool(nextValue: Uint<64>, capacity: Uint<64>): [] {
  const c = disclose(capacity);
  if (nextValue == 0) {
    assert(c == 0, "an empty pool has no slots");
  } else {
    assert(c * maxPayout <= nextValue - 1, "slot capacity overstated");
    assert((c + 1) * maxPayout > nextValue - 1, "slot capacity understated");
  }
  const old = slotCapacity;
  const grows = c >= old;
  const change = grows ? c - old : old - c;
  assert(change <= 65535, "the pool changes by too many slots at once");
  const step = change as Uint<16>;
  if (grows) {
    freeSlots.increment(step);
  } else {
    assert(!freeSlots.lessThan(step), "that liquidity is reserved for open positions");
    freeSlots.decrement(step);
  }
  slotCapacity = c;
  poolValue = nextValue;
}

// Deposits a pUSDC coin into the pool and mints zLP shares to the caller.
//
// `shares` is computed by the caller and checked here, because circuits cannot
// divide: it must be floor(amount * lpSupply / poolValue), or `amount` for the
// first deposit. The two inequalities below pin it to exactly that.
// `capacity` is the pool's slot capacity after the deposit; see `repool`.
export circuit addLiquidity(coin: ShieldedCoinInfo, shares: Uint<64>, capacity: Uint<64>): [] {
  const c = disclose(coin);
  const s = disclose(shares);
  assert(c.color == usdc, "the pool only takes pUSDC");
  assert(c.value > 0, "a deposit of nothing");
  assert(c.value <= 18446744073709551615, "deposit too large");
  const amount = c.value as Uint<64>;

  if (lpSupply == 0) {
    assert(s == amount, "the first deposit mints one share per unit");
  } else {
    assert(s * poolValue <= amount * lpSupply, "too many shares for this deposit");
    assert((s + 1) * poolValue > amount * lpSupply, "too few shares for this deposit");
  }
  assert(s > 0, "deposit too small to mint a share");

  receiveShielded(c);
  // The pool stays one coin: the first deposit becomes it, every later one is
  // merged into it in the same transaction.
  if (poolValue == 0) {
    pool.writeCoin(c, right<ZswapCoinPublicKey, ContractAddress>(kernel.self()));
  } else {
    pool.writeCoin(
      mergeCoinImmediate(pool, c),
      right<ZswapCoinPublicKey, ContractAddress>(kernel.self())
    );
  }

  const nextValue = poolValue + amount;
  assert(nextValue <= 18446744073709551615, "pool would overflow");
  repool(nextValue as Uint<64>, capacity);
  const nextSupply = lpSupply + s;
  assert(nextSupply <= 18446744073709551615, "share supply would overflow");
  lpSupply = nextSupply as Uint<64>;

  lpToken = tokenType(pad(32, "zkperp:zLP"), kernel.self());
  lpMintCounter.increment(1);
  mintShieldedToken(
    pad(32, "zkperp:zLP"),
    s,
    evolveNonce(lpMintCounter, kernel.self().bytes),
    left<ZswapCoinPublicKey, ContractAddress>(ownPublicKey())
  );
}

// Redeems a zLP coin for its share of the pool, paid to the caller.
//
// `amount` is computed by the caller, because circuits cannot divide: it must
// be floor(shares * poolValue / lpSupply), rounded in the pool's favour. The
// two inequalities below pin it to exactly that.
//
// Only liquidity that is not reserved can leave: the pool's slot capacity
// afterwards (`capacity`, see `repool`) must still cover every open position,
// so every open position's maximum profit stays payable. The last LP may
// empty an idle pool completely.
//
// The zLP coin is received and never spent: no circuit in this contract can
// name it, so it is retired for good, and `lpSupply` drops by its value. A
// future circuit that spends contract-held coins must keep it that way.
export circuit removeLiquidity(lp: ShieldedCoinInfo, amount: Uint<64>, capacity: Uint<64>): [] {
  const c = disclose(lp);
  const a = disclose(amount);
  assert(lpSupply > 0, "the pool has no shares");
  assert(c.color == lpToken, "only zLP redeems liquidity");
  assert(c.value > 0, "a withdrawal of nothing");
  assert(c.value <= lpSupply as Uint<128>, "more shares than exist");
  const shares = c.value as Uint<64>;

  assert(a * lpSupply <= shares * poolValue, "too much pUSDC for these shares");
  assert((a + 1) * lpSupply > shares * poolValue, "too little pUSDC for these shares");
  assert(a > 0, "too few shares to redeem a unit");

  // a <= poolValue follows from shares <= lpSupply and the bound above.
  const nextValue = (poolValue - a) as Uint<64>;
  const drained = nextValue == 0;
  repool(nextValue, capacity);

  receiveShielded(c);

  // As in closePosition: both branches below are evaluated in the proof, so the
  // send happens before the branch and each branch only writes the result.
  // When the whole pool leaves there is no change; the untaken writeCoin then
  // sees a zero-value default coin, which is in range.
  const paid = sendShielded(
    pool,
    left<ZswapCoinPublicKey, ContractAddress>(ownPublicKey()),
    a as Uint<128>
  );
  if (drained) {
    pool.resetToDefault();
  } else {
    pool.writeCoin(paid.change.value, right<ZswapCoinPublicKey, ContractAddress>(kernel.self()));
  }
  lpSupply = (lpSupply - shares) as Uint<64>;
}

// ── Trading ────────────────────────────────────────────────────────────────

// Opens a long or a short at the current mark price, with `coin` as
// collateral.
//
// `size`, `isLong`, `openFee`, `ownerSecret` and `salt` are circuit arguments,
// which are private: they reach the proof, not the transaction. So do the
// coin's value and nonce. What leaves this circuit is the commitment, the
// collateral coin's Zswap commitment, both hiding, and `openTime`, which says
// no more than the transaction's own timestamp.
//
// The opening fee is ceil(size × openFeeBps / 10 000). It stays in the coin;
// the position's collateral is what remains, and the leverage bounds apply to
// that.
//
// `note` is the opening encrypted for the trader (see `notes`). The contract
// cannot check it: a note that does not describe this position only hurts the
// trader who wrote it, who then needs a local record to close.
//
// `ephemeral` is a fresh random scalar for the liquidator's note (see
// `sealLiquidatorNote`); `payToLo`/`payToHi` are the opening wallet's coin key
// in halves, and `encLo`/`encHi` its encryption key, which the note carries so
// a liquidation can return equity visibly. All stay private. `salt` and the
// coin's nonce must be below the field size, as the note casts them.
//
// The payout key is the opening wallet's own (`ownPublicKey()`), bound into the
// commitment as `payTo`. Like every argument it is supplied by the caller, so
// it proves nothing about who opened; it only fixes where a close pays.
export circuit openPosition(
  coin: ShieldedCoinInfo,
  size: Uint<64>,
  isLong: Boolean,
  openFee: Uint<64>,
  openTime: Uint<64>,
  ownerSecret: Bytes<32>,
  salt: Bytes<32>,
  note: Bytes<128>,
  ephemeral: Field,
  payToLo: Bytes<16>,
  payToHi: Bytes<16>,
  encLo: Bytes<16>,
  encHi: Bytes<16>
): [] {
  // The token type is the same for every pUSDC coin, so disclosing it
  // reveals only that the collateral is pUSDC — which the contract requires.
  assert(disclose(coin.color) == usdc, "collateral must be pUSDC");

  // The open time may not be in the future, nor trail the block by more than
  // the slack. A later time would only lower the borrow fee, and the first
  // check forbids it.
  const t = disclose(openTime);
  assert(blockTimeGte(t), "open time is in the future");
  assert(blockTimeLt((t + clockSlack) as Uint<64>), "open time is too far in the past");
  freshPrice();

  const collateral = sizing(coin.value, size, openFee);

  // One slot of maxPayout, the same for every position, so it tells nobody
  // anything about this one. A check and a decrement, not a read of the
  // count: concurrent opens and closes do not invalidate each other.
  assert(!freeSlots.lessThan(1), "the pool has no room for another position");
  freeSlots.decrement(1);

  receiveShielded(disclose(coin));

  const position = Position {
    owner: ownerKey(ownerSecret),
    isLong: isLong,
    size: size,
    collateral: collateral,
    openFee: openFee,
    entryPrice: markPrice,
    openTime: t,
    collateralNonce: coin.nonce,
    salt: salt,
    payTo: ownPublicKey()
  };
  positions.insert(disclose(positionCommitment(position)));
  notes.insert(disclose(note));
  // Zero would make the keeper's shared secret public.
  assert(ephemeral != 0, "the ephemeral scalar must not be zero");
  // The halves the note carries must be the key the commitment binds. Equal
  // hashes, because a hash of the two halves and of the whole serialize the
  // same 32 bytes; cheaper by far than slicing the key in the proof.
  assert(
    persistentHash<Vector<2, Bytes<16>>>([payToLo, payToHi]) == persistentHash<Bytes<32>>(position.payTo.bytes),
    "the payout key halves do not match"
  );
  liquidatorNotes.insert(disclose(sealLiquidatorNote(
    liquidatorPlaintext(position, payToLo, payToHi, encLo, encHi),
    liquidator,
    ephemeral
  )));
  openPositions.increment(1);
}

// The position's collateral, net of the opening fee, from a coin of `value`;
// checks the fee and the leverage bounds. In the proof, against private
// values: a failed assert aborts proving, so a reader learns only that they
// held.
circuit sizing(value: Uint<128>, size: Uint<64>, openFee: Uint<64>): Uint<64> {
  assert(value <= 18446744073709551615, "collateral too large");
  const gross = value as Uint<64>;
  assert(openFee * 10000 >= size * openFeeBps, "opening fee understated");
  assert(openFee * 10000 < size * openFeeBps + 10000, "opening fee overstated");
  assert(openFee < gross, "the opening fee exceeds the collateral");
  const collateral = (gross - openFee) as Uint<64>;
  assert(collateral >= minCollateral, "collateral below the minimum");
  assert(size >= collateral, "size below collateral: leverage under 1x");
  assert(size <= collateral * maxLeverage, "leverage above the maximum");
  return collateral;
}

// Closes a position at the current mark price and settles: the PnL against
// the pool, the fees to the treasury.
//
// The caller proves, without saying which, that `position` is in `positions`
// and that they hold its owner secret. They then name the collateral coin the
// position committed to — nonce, value and Merkle index, which only they know
// — and the contract spends it. The coin holds the collateral plus the opening
// fee, and is divided, in this order of priority:
//
//   1. a loss, up to the whole collateral, merged into the pool;
//   2. the fees: the opening fee in full, then the closing and borrow fees out
//      of what collateral the loss left, to the treasury;
//   3. the rest back to the trader.
//
// A profit is paid on top, out of the pool, less any closing and borrow fees
// the collateral could not cover — those stay in the pool. A loss that takes
// the whole collateral leaves nothing for the closing and borrow fees: they
// are forgiven, and the pool keeps everything.
//
// A long profits when the price rose, a short when it fell; at an unchanged
// price both are flat. `pnl` is |PnL| in pUSDC minor units, computed by the
// caller because circuits cannot divide, and pinned here: with Δ = |exit −
// entry|, a profit must be min(floor(size × Δ / entry), maxPayout) and a loss
// ceil(size × Δ / entry), each in the pool's favour. `closeFee` must be
// ceil(size × closeFeeBps / 10 000) and `borrowFee` ceil(size × borrowRate ×
// (closeTime − openTime) / 10^12).
//
// `closeTime` is public, like the transaction's timestamp. The open time is
// not: it is inside the commitment, and publishing it would link the close to
// its open.
//
// The payout goes to `position.payTo`, the wallet that opened the position;
// there is no recipient argument. So the owner secret alone cannot redirect
// money: a thief who has it can force a close, nothing more. The key is
// disclosed to build the output, but a shielded output carries only a
// commitment, so it is not linkable to the key.
//
// `capacity` is the pool's slot capacity after a profit or loss (see
// `repool`); at an unchanged price it is ignored, and the close reads neither
// the pool coin nor its value.
export circuit closePosition(
  position: Position,
  ownerSecret: Bytes<32>,
  path: MerkleTreePath<20, Bytes<32>>,
  collateral: QualifiedShieldedCoinInfo,
  pnl: Uint<64>,
  closeFee: Uint<64>,
  borrowFee: Uint<64>,
  closeTime: Uint<64>,
  capacity: Uint<64>
): [] {
  assert(position.owner == ownerKey(ownerSecret), "not the owner of this position");
  retire(position, path);
  settle(position, collateral, pnl, closeFee, borrowFee, 0, closeTime, capacity, false);
}

// Closes a position whose equity is below maintenance margin, without its
// owner secret: the keeper knows every other field from the position's
// liquidator note. Settles as `closePosition` does, plus a liquidation fee of
// ceil(size × liquidationFeeBps / 10 000) out of what equity is left, to the
// treasury. Whatever equity remains after that still goes to `payTo`.
//
// Only a position at a loss, or flat, can be liquidated; one in profit is
// above maintenance by construction of the leverage cap.
export circuit liquidatePosition(
  position: Position,
  path: MerkleTreePath<20, Bytes<32>>,
  collateral: QualifiedShieldedCoinInfo,
  pnl: Uint<64>,
  closeFee: Uint<64>,
  borrowFee: Uint<64>,
  liquidationFee: Uint<64>,
  closeTime: Uint<64>,
  capacity: Uint<64>
): [] {
  retire(position, path);
  settle(position, collateral, pnl, closeFee, borrowFee, liquidationFee, closeTime, capacity, true);
}

// Attaches a trigger order to the caller's position; see "Trigger orders"
// above. Proves ownership, so only the owner can place one. Does not check the
// position is still open: an order on a closed position can never fire.
export circuit placeOrder(position: Position, ownerSecret: Bytes<32>, order: TriggerOrder, note: LiquidatorNote): [] {
  assert(position.owner == ownerKey(ownerSecret), "not the owner of this position");
  assert(order.position == positionCommitment(position), "the order is for another position");
  assert(order.price > 0, "the order's price must be positive");
  orders.insert(disclose(orderCommitment(order)));
  orderNotes.insert(disclose(note));
}

// Cancels an order, so it can no longer fire. Owner only, like placing one.
export circuit cancelOrder(position: Position, ownerSecret: Bytes<32>, order: TriggerOrder): [] {
  assert(position.owner == ownerKey(ownerSecret), "not the owner of this position");
  assert(order.position == positionCommitment(position), "the order is for another position");
  cancelledOrders.insert(disclose(orderNullifier(order.salt)));
}

// Closes a position whose order's price has been reached, without the owner
// secret: the keeper knows the position from its liquidator note and the
// order from its order note. Settles as `closePosition` does, at the mark
// price, to the position's `payTo`.
export circuit executeOrder(
  position: Position,
  path: MerkleTreePath<20, Bytes<32>>,
  order: TriggerOrder,
  orderPath: MerkleTreePath<20, Bytes<32>>,
  collateral: QualifiedShieldedCoinInfo,
  pnl: Uint<64>,
  closeFee: Uint<64>,
  borrowFee: Uint<64>,
  closeTime: Uint<64>,
  capacity: Uint<64>
): [] {
  assert(order.position == positionCommitment(position), "the order is for another position");
  assert(orderPath.leaf == orderCommitment(order), "path is for a different order");
  assert(
    orders.checkRoot(disclose(merkleTreePathRoot<20, Bytes<32>>(orderPath))),
    "no such order"
  );
  assert(!cancelledOrders.member(disclose(orderNullifier(order.salt))), "the order was cancelled");
  // The price is read once, outside the condition: a ledger read inside a
  // branch would publish which branch, and so the order's direction.
  const mark = markPrice;
  assert(order.above ? mark >= order.price : mark <= order.price, "the order's price has not been reached");
  retire(position, path);
  settle(position, collateral, pnl, closeFee, borrowFee, 0, closeTime, capacity, false);
}

// Places a limit order; see "Limit orders" above. Takes the collateral coin
// as `openPosition` does, and checks the same fee and leverage bounds, so a
// fill only has to check the price and the pool's room.
//
// `note` is the order encrypted for the trader, like a position's note;
// `keeperNote` the order sealed to the liquidator key by the trader (see
// core/limits.ts). Neither is checked: a false one only stops the trader's own
// order from being found or filled, and the trader can still cancel it.
//
// Not checked against the mark price: an order whose limit is already
// reached fills on the keeper's next look, like a market order. Nor is the
// expiry checked against the clock: one already past only stops the trader's
// own order from filling.
export circuit placeLimitOrder(
  coin: ShieldedCoinInfo,
  size: Uint<64>,
  isLong: Boolean,
  openFee: Uint<64>,
  price: Uint<64>,
  expiry: Uint<64>,
  ownerSecret: Bytes<32>,
  salt: Bytes<32>,
  payToEnc: Bytes<32>,
  note: Bytes<128>,
  keeperNote: LiquidatorNote
): [] {
  assert(disclose(coin.color) == usdc, "collateral must be pUSDC");
  assert(price > 0, "the limit price must be positive");
  const collateral = sizing(coin.value, size, openFee);
  receiveShielded(disclose(coin));
  const order = LimitOrder {
    owner: ownerKey(ownerSecret),
    isLong: isLong,
    size: size,
    collateral: collateral,
    openFee: openFee,
    price: price,
    expiry: expiry,
    collateralNonce: coin.nonce,
    salt: salt,
    payTo: ownPublicKey(),
    payToEnc: payToEnc
  };
  limitOrders.insert(disclose(limitCommitment(order)));
  notes.insert(disclose(note));
  limitNotes.insert(disclose(keeperNote));
}

// Fills a limit order whose price is reached, without the owner secret: the
// keeper knows the order from its note. Opens the position at the mark price
// with the order's coin as its collateral, as `openPosition` would have, and
// writes its liquidator note. `openTime`, `ephemeral` and the key halves are
// as in `openPosition`; the halves must match the order's keys.
export circuit executeLimitOrder(
  order: LimitOrder,
  path: MerkleTreePath<20, Bytes<32>>,
  openTime: Uint<64>,
  ephemeral: Field,
  payToLo: Bytes<16>,
  payToHi: Bytes<16>,
  encLo: Bytes<16>,
  encHi: Bytes<16>
): [] {
  const nullifier = spendLimit(order, path);
  const t = disclose(openTime);
  assert(blockTimeGte(t), "open time is in the future");
  assert(blockTimeLt((t + clockSlack) as Uint<64>), "open time is too far in the past");
  freshPrice();
  // Read once, outside the condition, as in `executeOrder`: the direction
  // stays private.
  const mark = markPrice;
  assert(order.isLong ? mark <= order.price : mark >= order.price, "the limit price has not been reached");
  assert(order.expiry == 0 || t < order.expiry, "the limit order has expired");

  assert(!freeSlots.lessThan(1), "the pool has no room for another position");
  freeSlots.decrement(1);

  const position = Position {
    owner: order.owner,
    isLong: order.isLong,
    size: order.size,
    collateral: order.collateral,
    openFee: order.openFee,
    entryPrice: mark,
    openTime: t,
    collateralNonce: order.collateralNonce,
    salt: order.salt,
    payTo: order.payTo
  };
  positions.insert(disclose(positionCommitment(position)));
  limitFills.insert(nullifier, LimitFill { entryPrice: mark, openTime: t });
  assert(ephemeral != 0, "the ephemeral scalar must not be zero");
  assert(
    persistentHash<Vector<2, Bytes<16>>>([payToLo, payToHi]) == persistentHash<Bytes<32>>(order.payTo.bytes),
    "the payout key halves do not match"
  );
  assert(
    persistentHash<Vector<2, Bytes<16>>>([encLo, encHi]) == persistentHash<Bytes<32>>(order.payToEnc),
    "the encryption key halves do not match"
  );
  liquidatorNotes.insert(disclose(sealLiquidatorNote(
    liquidatorPlaintext(position, payToLo, payToHi, encLo, encHi),
    liquidator,
    ephemeral
  )));
  openPositions.increment(1);
}

// Cancels a limit order that has not filled, owner only, and returns its
// coin to `payTo`. `collateral` names the coin as a close does.
export circuit cancelLimitOrder(
  order: LimitOrder,
  ownerSecret: Bytes<32>,
  path: MerkleTreePath<20, Bytes<32>>,
  collateral: QualifiedShieldedCoinInfo
): [] {
  assert(order.owner == ownerKey(ownerSecret), "not the owner of this order");
  spendLimit(order, path);
  assert(collateral.nonce == order.collateralNonce, "not this order's collateral coin");
  assert(disclose(collateral.color) == usdc, "collateral must be pUSDC");
  assert(
    collateral.value == (order.collateral + order.openFee) as Uint<128>,
    "collateral coin value does not match"
  );
  sendShielded(
    disclose(collateral),
    left<ZswapCoinPublicKey, ContractAddress>(disclose(order.payTo)),
    disclose(collateral.value)
  );
}

// Proves `order` is in `limitOrders` without naming its leaf, and spends its
// nullifier, so it fills or cancels once. Returns the nullifier.
circuit spendLimit(order: LimitOrder, path: MerkleTreePath<20, Bytes<32>>): Bytes<32> {
  assert(path.leaf == limitCommitment(order), "path is for a different limit order");
  assert(
    limitOrders.checkRoot(disclose(merkleTreePathRoot<20, Bytes<32>>(path))),
    "no such limit order"
  );
  const nullifier = disclose(limitNullifier(order.salt));
  assert(!limitDone.member(nullifier), "the limit order already filled or was cancelled");
  limitDone.insert(nullifier);
  return nullifier;
}

// Proves `position` is in `positions` without naming its leaf, and spends its
// nullifier so it cannot settle twice.
circuit retire(position: Position, path: MerkleTreePath<20, Bytes<32>>): [] {
  assert(path.leaf == positionCommitment(position), "path is for a different position");
  assert(
    positions.checkRoot(disclose(merkleTreePathRoot<20, Bytes<32>>(path))),
    "no such position"
  );
  const nullifier = disclose(positionNullifier(position.salt));
  assert(!closed.member(nullifier), "position already closed");
  closed.insert(nullifier);
}

// The settlement shared by a close and a liquidation; see `closePosition`. For
// a close `liquidation` is false and `liquidationFee` zero.
circuit settle(
  position: Position,
  collateral: QualifiedShieldedCoinInfo,
  pnl: Uint<64>,
  closeFee: Uint<64>,
  borrowFee: Uint<64>,
  liquidationFee: Uint<64>,
  closeTime: Uint<64>,
  capacity: Uint<64>,
  liquidation: Boolean
): [] {
  // The coin must be the one this position committed to, or a trader could
  // close their position against someone else's collateral.
  assert(collateral.nonce == position.collateralNonce, "not this position's collateral coin");
  assert(disclose(collateral.color) == usdc, "collateral must be pUSDC");
  assert(
    collateral.value == (position.collateral + position.openFee) as Uint<128>,
    "collateral coin value does not match"
  );

  // The trader gains from naming the close time early, so it may trail the
  // block by at most the slack, and may not precede the open.
  const now = disclose(closeTime);
  assert(blockTimeGte(now), "close time is in the future");
  assert(blockTimeLt((now + clockSlack) as Uint<64>), "close time is too far in the past");
  freshPrice();
  assert(now >= position.openTime, "close time is before the open");
  const held = now - position.openTime;

  assert(closeFee * 10000 >= position.size * closeFeeBps, "closing fee understated");
  assert(closeFee * 10000 < position.size * closeFeeBps + 10000, "closing fee overstated");
  const accrued = position.size * borrowRate * held;
  assert(borrowFee * 1000000000000 >= accrued, "borrow fee understated");
  assert(borrowFee * 1000000000000 < accrued + 1000000000000, "borrow fee overstated");

  const exit = markPrice;
  const entry = position.entryPrice;
  const payTo = left<ZswapCoinPublicKey, ContractAddress>(disclose(position.payTo));
  const coin = disclose(collateral);
  const amount = disclose(pnl);

  // The move's size, whichever way it went; its direction only decides who
  // is paid. Disclosed: whether the trader won is what the pool's change
  // publishes anyway.
  const rose = exit >= entry;
  const move = rose ? exit - entry : entry - exit;
  const delta = position.size * move;
  const isProfit = disclose(position.isLong ? rose : exit <= entry);

  // PnL is checked against the move in both directions. Each pair only binds
  // when its direction is the real one; see the note below on branches.
  if (isProfit) {
    assert(pnl <= maxPayout, "profit above the payout cap");
    assert(pnl * entry <= delta, "profit overstated");
    // Exact, unless capped: the cap is an enforced take-profit.
    assert(pnl == maxPayout || (pnl + 1) * entry > delta, "profit understated");
  } else {
    assert(pnl * entry >= delta, "loss understated");
    assert(pnl * entry < delta + entry, "loss overstated");
  }

  // A liquidation takes a loss, or a flat position eaten by fees, never a
  // profit, and pins its fee like the others. A close charges none.
  assert(!liquidation || !isProfit || pnl == 0, "a position in profit cannot be liquidated");
  assert(liquidation || liquidationFee == 0, "only a liquidation charges a liquidation fee");
  assert(
    !liquidation || liquidationFee * 10000 >= position.size * liquidationFeeBps,
    "liquidation fee understated"
  );
  assert(
    !liquidation || liquidationFee * 10000 < position.size * liquidationFeeBps + 10000,
    "liquidation fee overstated"
  );

  // ⚠️ Why the amounts are chosen here, before any branch, and why `pool` is
  // read once up front.
  //
  // In the proof, EVERY branch of an `if` is evaluated; only the taken one's
  // effects are kept. A ledger read inside an untaken branch yields a default
  // (a zero-value coin), and a value that goes negative there is still fed to
  // the coin-commitment hash — which then rejects the whole proof ("Inputs did
  // not match alignment"), though that branch never ran. The JS runtime runs
  // only the taken branch, so local tests cannot see it; the first devnet loss
  // close failed exactly this way (0 − loss as a pool change).
  //
  // So every amount is selected up front, and each stdlib call below gets
  // values that are in range whichever branch is taken: no amount exceeds the
  // coin it is taken from. The pool coin is read only in the branches that
  // spend or grow it — an untaken read yields a zero-value coin, and the
  // amounts there are zero — so a close that leaves the pool alone does not
  // conflict with one that changes it.
  const net = position.collateral;

  // 1. The loss, at most the whole collateral. Disclosed: it is the pool's
  //    change, public anyway. A wipe-out publishes the collateral this way.
  const lossAmt: Uint<64> = disclose(isProfit ? 0 : (amount >= net ? net : amount));
  const afterLoss = (net - lossAmt) as Uint<64>;

  // 2. Fees. Closing and borrow fees come out of what the loss left; any
  //    excess is the shortfall, taken from a profit below.
  const fees = closeFee + borrowFee;
  const feeTaken = (fees >= afterLoss ? afterLoss : fees) as Uint<64>;
  const shortfall = fees - feeTaken;
  // What the trader still has in the coin: the equity margin is measured on.
  const equity = (afterLoss - feeTaken) as Uint<64>;
  assert(
    !liquidation || equity * 10000 < position.size * maintenanceBps,
    "the position is above maintenance margin"
  );
  // 2b. A liquidation's fee, out of the equity; zero for a close.
  const liqTaken = (liquidationFee >= equity ? equity : liquidationFee) as Uint<64>;
  // Disclosed to build the treasury's output; a shielded output's value is
  // inside its commitment, so this publishes nothing.
  const toTreasury = disclose((position.openFee + feeTaken + liqTaken) as Uint<64>);

  // 3. The trader's share of the coin.
  const back = disclose((equity - liqTaken) as Uint<64>);

  // A profit, less the shortfall. Disclosed: it is the pool's change.
  const profitRaw: Uint<64> = isProfit ? amount : 0;
  const profitAmt = disclose((profitRaw >= shortfall ? profitRaw - shortfall : 0) as Uint<64>);

  // Whether the trader gets anything from the coin. Disclosed because it
  // decides whether an output to them exists; it is false only when the loss
  // and fees took the whole collateral.
  const hasBack = disclose(back > 0);

  // The treasury first: the opening fee is at least 1, so this send is never
  // of nothing. The change holds exactly lossAmt + back.
  const fromCoin = sendShielded(
    coin,
    left<ZswapCoinPublicKey, ContractAddress>(treasury),
    toTreasury as Uint<128>
  );
  const rest = fromCoin.change.value;
  if (hasBack) {
    const paid = sendImmediateShielded(rest, payTo, back as Uint<128>);
    if (lossAmt > 0) {
      pool.writeCoin(
        mergeCoinImmediate(pool, paid.change.value),
        right<ZswapCoinPublicKey, ContractAddress>(kernel.self())
      );
    }
  } else if (lossAmt > 0) {
    pool.writeCoin(
      mergeCoinImmediate(pool, rest),
      right<ZswapCoinPublicKey, ContractAddress>(kernel.self())
    );
  }
  if (profitAmt > 0) {
    // Holds by the reservation invariant (profit ≤ maxPayout, and the pool
    // backs this position's slot); checked anyway, since a send of the whole
    // pool would leave no coin to write back.
    assert(profitAmt < poolValue, "the pool cannot pay this profit");
    const paid = sendShielded(pool, payTo, profitAmt as Uint<128>);
    pool.writeCoin(paid.change.value, right<ZswapCoinPublicKey, ContractAddress>(kernel.self()));
  }
  if (disclose(lossAmt > 0 || profitAmt > 0)) {
    repool((poolValue + lossAmt - profitAmt) as Uint<64>, capacity);
  }
  freeSlots.increment(1);
  closedPositions.increment(1);
}

// The treasury's per-epoch payment of the LPs' share of fees. Adds `coin` to
// the pool without minting shares, so every zLP share is worth more.
//
// Anyone may call it — it only gives — but it is how fees reach LPs.
// `capacity` is the pool's slot capacity after the deposit; see `repool`. Only the
// deposit is public, never the fees it sums. The split between LPs and the
// protocol is the treasury's to make; the contract cannot see the fees.
export circuit depositFees(coin: ShieldedCoinInfo, capacity: Uint<64>): [] {
  const c = disclose(coin);
  assert(c.color == usdc, "fees are paid in pUSDC");
  assert(c.value > 0, "a deposit of nothing");
  assert(c.value <= 18446744073709551615, "deposit too large");
  // With no LPs the deposit would belong to whoever deposits first.
  assert(lpSupply > 0, "no LPs to pay");

  receiveShielded(c);
  pool.writeCoin(mergeCoinImmediate(pool, c), right<ZswapCoinPublicKey, ContractAddress>(kernel.self()));
  const nextValue = poolValue + c.value as Uint<64>;
  assert(nextValue <= 18446744073709551615, "pool would overflow");
  repool(nextValue as Uint<64>, capacity);
}
